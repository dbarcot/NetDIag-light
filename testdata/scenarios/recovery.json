{
  "name": "recovery",
  "description": "Gateway path is down at start and comes back at t=20s: every gate reopens",
  "duration_s": 90,
  "sysinfo": {
    "adapter": { "name": "Ethernet", "type": "ethernet", "up": true, "ipv4": "192.168.1.23/24" },
    "gateway": { "ip": "192.168.1.1", "mac": "aa:bb:cc:dd:ee:ff" },
    "dns_servers": ["192.168.1.1"]
  },
  "rules": [
    { "probes": ["LAN-01", "NET-01", "NET-04", "RT-01", "MTU-01"], "to_s": 20, "result": "fail" },
    { "probe": "LAN-02", "to_s": 20, "arp_state": "unreachable" }
  ],
  "expect": [
    { "at_s": 10, "verdict": "GW_UNREACHABLE", "gates": { "L3": "closed" } },
    { "at_s": 35, "gates": { "L1": "open", "L2": "open", "L3": "open", "L4": "open", "L5": "open" } },
    { "at_s": 90, "verdict": "OK" }
  ]
}
