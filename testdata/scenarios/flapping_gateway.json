{
  "name": "flapping_gateway",
  "description": "Gateway path fails two seconds out of three: never three in a row, so the gate stays open (hysteresis) and the loss shows as LAN_LOSS",
  "duration_s": 60,
  "sysinfo": {
    "adapter": { "name": "Ethernet", "type": "ethernet", "up": true, "ipv4": "192.168.1.23/24" },
    "gateway": { "ip": "192.168.1.1", "mac": "aa:bb:cc:dd:ee:ff" },
    "dns_servers": ["192.168.1.1"]
  },
  "rules": [ { "probes": ["LAN-01", "LAN-02", "NET-01", "NET-04", "RT-01"], "from_s": 10, "pattern": "ffo" } ],
  "expect": [
    { "at_s": 40, "verdict": "LAN_LOSS", "gates": { "L3": "open", "L4": "open" }, "flags_exclude": ["GW_ICMP_BLOCKED"] },
    { "at_s": 55, "gates": { "L3": "open", "L4": "open" } }
  ]
}
