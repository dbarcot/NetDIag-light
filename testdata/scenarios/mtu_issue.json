{
  "name": "mtu_issue",
  "description": "PMTUD black hole: packets above 1380 bytes to the internet are dropped without 'packet too big'. One low run is nothing yet; the second confirmed run raises MTU_ISSUE",
  "duration_s": 40,
  "config": { "rates": { "mtu": 10 } },
  "sysinfo": {
    "adapter": { "name": "Ethernet", "type": "ethernet", "up": true, "ipv4": "192.168.1.23/24" },
    "gateway": { "ip": "192.168.1.1", "mac": "aa:bb:cc:dd:ee:ff" },
    "dns_servers": ["192.168.1.1"]
  },
  "rules": [ { "probe": "MTU-01", "target": "1.1.1.1", "value": 1380, "bound": "silent" } ],
  "expect": [
    { "at_s": 5, "verdict": "OK", "flags_exclude": ["MTU_REDUCED:1380"] },
    { "at_s": 30, "verdict": "MTU_ISSUE", "exit_code": 22, "detail_contains": "1380" }
  ]
}
