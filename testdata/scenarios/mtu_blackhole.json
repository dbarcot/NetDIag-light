{
  "name": "mtu_blackhole",
  "description": "A black hole that goes away: two silent low runs raise MTU_ISSUE (the first alone does not), the next good run clears it",
  "duration_s": 50,
  "config": { "rates": { "mtu": 10 } },
  "sysinfo": {
    "adapter": { "name": "Ethernet", "type": "ethernet", "up": true, "ipv4": "192.168.1.23/24" },
    "gateway": { "ip": "192.168.1.1", "mac": "aa:bb:cc:dd:ee:ff" },
    "dns_servers": ["192.168.1.1"]
  },
  "rules": [ { "probe": "MTU-01", "target": "1.1.1.1", "to_s": 25, "value": 1380, "bound": "silent" } ],
  "expect": [
    { "at_s": 5, "verdict": "OK" },
    { "at_s": 15, "verdict": "MTU_ISSUE", "exit_code": 22 },
    { "at_s": 45, "verdict": "OK" }
  ]
}
