{
  "name": "adapter_change",
  "description": "Laptop on a lossy Wi-Fi link (50 % loss to the gateway and the internet from t=10s) moves to an Ethernet dock at t=30s: new adapter, address, gateway and DNS. The loss measured on the old path must not outlive the move (new series)",
  "duration_s": 60,
  "sysinfo": {
    "adapter": { "name": "Wi-Fi", "type": "wifi", "up": true, "ipv4": "192.168.1.23/24" },
    "gateway": { "ip": "192.168.1.1" },
    "dns_servers": ["192.168.1.1"],
    "wifi": { "ssid": "Home", "signal_pct": 30, "band": "5GHz", "channel": 36 }
  },
  "rules": [ { "probes": ["LAN-01", "NET-01"], "from_s": 10, "to_s": 30, "loss_pct": 50 } ],
  "events": [
    { "at_s": 30, "sysinfo": {
      "adapter": { "name": "Ethernet", "type": "ethernet", "ipv4": "10.0.0.23/24" },
      "gateway": { "ip": "10.0.0.1" },
      "dns_servers": ["10.0.0.1"] } }
  ],
  "expect": [
    { "at_s": 8, "verdict": "OK", "primary_adapter": "Wi-Fi", "adapter_changes": 0, "flags_include": ["WIFI_WEAK"] },
    { "at_s": 29, "verdict": "LAN_LOSS", "adapter_changes": 0 },
    { "at_s": 30, "adapter_changes": 1, "gates": { "L3": "open" } },
    { "at_s": 42, "verdict": "OK", "primary_adapter": "Ethernet", "adapter_changes": 1, "flags_exclude": ["WIFI_WEAK", "GW_ICMP_RATE_LIMITED"] },
    { "at_s": 58, "verdict": "OK", "primary_adapter": "Ethernet", "adapter_changes": 1 }
  ]
}
