{
  "name": "isp_loss",
  "description": "10 % loss to both internet targets while the LAN is clean",
  "duration_s": 50,
  "sysinfo": {
    "adapter": { "name": "Ethernet", "type": "ethernet", "up": true, "ipv4": "192.168.1.23/24" },
